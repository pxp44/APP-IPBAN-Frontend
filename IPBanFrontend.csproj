<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>IPBanFrontend</RootNamespace>
    <AssemblyName>IPBanFrontend</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon />
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- AnyCPU + wrong native sqlite DLL caused: type initializer SqliteConnection failed -->
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <!-- Ensure x64 e_sqlite3.dll is in output (SDK sometimes flattens the x86 one). -->
  <Target Name="CopySqliteNativeX64" AfterTargets="Build">
    <PropertyGroup>
      <_NuGetRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</_NuGetRoot>
    </PropertyGroup>
    <ItemGroup>
      <_SqliteNativeCand Include="$(_NuGetRoot)sqlitepclraw.lib.e_sqlite3\**\runtimes\win-x64\native\e_sqlite3.dll" />
      <_SqliteNativeCand Include="$(USERPROFILE)\.nuget\packages\sqlitepclraw.lib.e_sqlite3\**\runtimes\win-x64\native\e_sqlite3.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_SqliteNativeCand)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="false" Condition="'@(_SqliteNativeCand)' != ''" />
    <Warning Text="x64 e_sqlite3.dll not found (NuGetPackageRoot=$(_NuGetRoot))" Condition="'@(_SqliteNativeCand)' == ''" />
  </Target>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="7.0.20" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>
</Project>
