# IPThreat API key from ipthreat.net
# Copy this file to .env and fill in the value. Do not commit .env.
#
# Share: IPBan submits failed logins (ipban.config → IPThreatApiKey).
# Receive: FirewallUriRules uses https://lists.ipthreat.net/.../threat-{level}.txt.gz
#
# Paste only the key (usually ends with ==). Do not include a numeric id after it.
# Sharing also needs bulk-report permission: https://ipthreat.net/requestpermissions
IPThreat_API_KEY=
